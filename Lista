#include <iostream>
#include <string.h>
#include <stdlib.h>
using namespace std;

struct No{
	int valor;
	No *prox;
};

struct Lista{
	No *inicio;
	int tam;
};

void InicializarLista(Lista *lista){
	lista->inicio = NULL;
	lista->tam = 0;
}

Lista* Criar_Lista(){
	Lista *lista;
	
	lista = (Lista *) malloc(sizeof(Lista));
	if (lista != NULL){
		InicializarLista(lista);
	}
	
	return lista;
}

void InserirLista(Lista *lista, int valor){
	No *novo = (No*) malloc(sizeof(No));
	novo->valor = valor;
	novo->prox = lista->inicio;
	lista->inicio = novo;
	lista->tam++;
}

void Remover(Lista *lista, int num){
	No *ptL, *aux;
	if(lista != NULL){
		ptL = lista->inicio;
		if(lista->inicio->valor == num){
			lista->inicio = lista->inicio->prox;
			free(ptL);
			--lista->tam;
		}
			else{
				while(ptL->prox != NULL && ptL->prox->valor != num){
					ptL = ptL->prox;
				}
				if(ptL->prox != NULL){
					aux = ptL->prox;
					ptL->prox = ptL->prox->prox;
					free(aux);
					--lista->tam;
				}
			}
		
	}
}

void Imprimir(Lista lista){
	No *ptL;
	for(ptL = lista.inicio; ptL != NULL; ptL = ptL->prox){
		cout << ptL->valor << " ";
	}
	cout << endl;
}

void ContarLista(Lista L1){
	cout << L1.tam;
}

void ContarOcorrencia(Lista lista, int num){
	No *ptL;
	int cont = 0;
	for(ptL = lista.inicio; ptL != NULL; ptL = ptL->prox){
		if(ptL->valor == num){
			cont++;
		}
	}
	cout << endl << "O valor aparece " << cont << " vez(es)" << endl;
	system("pause");
}

void Substituir(Lista *lista, int Valor, int Novo){
	No *ptL;
	for(ptL = lista->inicio; ptL != NULL; ptL = ptL->prox){
		if(ptL->valor == Valor){
			ptL->valor = Novo;
		}
	}
	cout << "Nova lista: ";
	Imprimir(*lista);
	system("pause");
}

void Dividir(Lista *lista, int num){
	Lista *maiores; 
	Lista *menores;
	maiores = Criar_Lista();
	menores = Criar_Lista();
	No *ptL;
	for(ptL = lista->inicio; ptL != NULL; ptL = ptL->prox){
		if(ptL->valor > num){
			InserirLista(maiores, ptL->valor);	
		}
		else{
			InserirLista(menores, ptL->valor);
		}
	}
	
	cout << "Lista com os valores menores/iguais a " << num << ": ";
	Imprimir(*menores);
	cout << endl << "Lista com os valores maiores que " << num << ": ";
	Imprimir(*maiores);
}

void Intersec(Lista lista1, Lista lista2){
	Lista *intersec;
	intersec = Criar_Lista();
	for(No *ptL1 = lista1.inicio; ptL1 != NULL; ptL1 = ptL1->prox){
		for(No *ptL2 = lista2.inicio; ptL2 != NULL; ptL2 = ptL2->prox){
			if(ptL1->valor == ptL2->valor){
				InserirLista(intersec, ptL1->valor);
			}
		}
	}
	Imprimir(*intersec);
}


Lista* Selecionar_Lista(Lista *L1, Lista *L2){
	int Op;
	Lista *L;
	
	do{
		cout << endl << "Qual lista deseja utilizar? (Lista 1 = [1], Lista 2 [2])" << endl;
		cout << "Resposta: ";                                                                                                                          		
		cin >> Op;
		if (Op!=1 && Op!=2){
			cout << endl << "Lista invalida!!" << endl;
		}
		else{
			if (Op==1){
				L = L1;	
			}
			else{
				L = L2;
			}
		}
	}while (Op!=1 && Op!=2);
	
	return L;
}

